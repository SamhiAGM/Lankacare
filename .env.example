# =============================================================
# MINISTRY OF HEALTH DIGITAL HEALTH PLATFORM - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ---- BACKEND ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ministry-health?retryWrites=true&w=majority

# JWT Secrets - use long, random strings in production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- FRONTEND ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ---- DEMO ACCOUNTS (for seeding only) ----
DEMO_SUPER_ADMIN_PASSWORD=SuperAdmin@123
DEMO_MINISTRY_ADMIN_PASSWORD=MinistryAdmin@123
DEMO_HOSPITAL_ADMIN_PASSWORD=HospitalAdmin@123
DEMO_DOCTOR_PASSWORD=Doctor@123
DEMO_CITIZEN_PASSWORD=Citizen@123
